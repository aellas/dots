! Terminal geometry
st.termname: st-256color
st.cols: 120
st.rows: 28

! Font
st.font: IosevkaTerm Nerd Font:size=12

! Background color (Tokyo Night background)
st.background: #13141c
st.foreground: #a9b1d6

! Cursor
st.cursorColor: #c0caf5
st.cursorstyle: 2  ! underline

! Colors (Tokyo Night theme)
! Black
st.color0:  #15161e
st.color8:  #414868

! Red
st.color1:  #f7768e
st.color9:  #f7768e

! Green
st.color2:  #9ece6a
st.color10: #9ece6a

! Yellow
st.color3:  #e0af68
st.color11: #e0af68

! Blue
st.color4:  #7aa2f7
st.color12: #7aa2f7

! Magenta
st.color5:  #bb9af7
st.color13: #bb9af7

! Cyan
st.color6:  #7dcfff
st.color14: #7dcfff

! White
st.color7:  #a9b1d6
st.color15: #c0caf5
