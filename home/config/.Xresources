! Fonts DPI
Xft.dpi: 144

! Cursor
Xcursor.size: 32

! Terminal geometry
st.termname: st-256color
st.cols: 120
st.rows: 28
st.borderpx: 10
! Font
st.font: IosevkaTerm Nerd Font:size=12

! Cursor style
st.cursorstyle: 2  ! underline

! ST default colors (Tokyo Night as fallback)
st.background: #111117
st.foreground: #c0caf5
st.cursorColor: #c0caf5

! Black
st.color0:  #15161e
st.color8:  #414868

! Red
st.color1:  #f7768e
st.color9:  #f7768e

! Green
st.color2:  #9ece6a
st.color10: #9ece6a

! Yellow
st.color3:  #e0af68
st.color11: #e0af68

! Blue
st.color4:  #7aa2f7
st.color12: #7aa2f7

! Magenta
st.color5:  #bb9af7
st.color13: #bb9af7

! Cyan
st.color6:  #7dcfff
st.color14: #7dcfff

! White
st.color7:  #c0caf5
st.color15: #c0caf5
