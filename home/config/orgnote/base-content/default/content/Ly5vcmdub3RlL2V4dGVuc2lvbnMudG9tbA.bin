[extensions.manifest.source]
type = "builtin"

[extensions.config]
pomoDuration = 25
soundEnabled = true

[[extensions]]
active = true

[extensions.manifest]
name = "Org Templates"
version = "0.0.1"
category = "extension"
description = "Create org notes from vault-local templates"
keywords = [ "templates", "notes", "org-mode" ]

[extensions.manifest.source]
type = "builtin"

[extensions.config]
defaultTemplatePath = "/.orgnote/templates/default.org.tmpl"
