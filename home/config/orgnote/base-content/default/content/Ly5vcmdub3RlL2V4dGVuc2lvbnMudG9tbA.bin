[[extensions]]
active = true

[extensions.manifest]
name = "Smart editing"
description = "Smart Enter handling (auto-continue lists, exit blocks) and auto-pair markup symbols (*, /, =, ~, +, [)"
version = "0.0.1"
category = "extension"
keywords = [ "editor", "editing", "lists", "blocks", "markup", "pairs" ]

[extensions.manifest.source]
type = "builtin"

[extensions.config]
enableSmartEnter = true
enableAutoPair = true
enableBackspacePairDelete = true

[[extensions]]
active = true

[extensions.manifest]
