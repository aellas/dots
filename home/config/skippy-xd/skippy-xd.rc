[layout]
switchLayout = cosmos
exposeLayout = cosmos
switchWaitDuration = 200
switchCycleDuringWait = false
switchCycleDesktops = false
exposeCycleDesktops = true
distance = 50
upscaleWindows = true

[appearance]
animationDuration = 0
animationRefresh = 60
background = None
preservePages = true
includeFrame = false
leftFrameBorder = 0
topFrameBorder = 0
cornerRadius = 0

[livepreview]
opacity = 500


[highlight]
tint = #4C7899
tintOpacity = 64
tintWindow = true
tintBorder = 0

[label]
show = false

[tooltip]
show = true
followsMouse = true
offsetX = 20
offsetY = 20
align = left
border = #ffffff
background = #404040
opacity = 128
text = #ffffff
textShadow = #000000
font = fixed-11:weight=bold

[bindings]

# Mouse button bindings
# Left click: select and end paging
# Right click: cancel
# Middle click: close window
# Scroll: cycle through desktops

# Keyboard bindings
# Escape: cancel paging
# Return: select focused window
# q: cancel
# Left/Right/Up/Down: navigate
# Tab: cycle forward
# Shift+Tab: cycle backward
# 1-9: jump to desktop number
# F1-F12: jump to desktop

# For paging mode, these are most useful:
# - Arrow keys to navigate between workspaces
# - Tab to cycle windows
# - 1-9 to jump to desktop directly
# - Enter to select
# - Escape or q to cancel

[general]

# Daemonize and start in background
# Set to true if you want skippy-xd to stay resident
# For bspwm, you can run on-demand or as daemon
daemonize = false
